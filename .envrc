# Managed by deepfake-env-kit. Review this file before `direnv allow`.
# No package installation or uv sync is performed when entering the directory.

export CUDA_HOME="/usr/local/cuda-13.2"
export CUDACXX="$CUDA_HOME/bin/nvcc"
export UV_PYTHON_INSTALL_DIR="/opt/uv/python"
export UV_PROJECT_ENVIRONMENT="/opt/venvs/deepfake-cu132"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"

# Python 3.12 is managed by uv in /opt/uv/python; do not disable its discovery.
unset UV_NO_MANAGED_PYTHON

PATH_add "$CUDA_HOME/bin"
if [ -x "$VIRTUAL_ENV/bin/python" ]; then
    PATH_add "$VIRTUAL_ENV/bin"
else
    echo "deepfake: missing $VIRTUAL_ENV/bin/python; run scripts/devctl sync as environment maintainer" >&2
fi
