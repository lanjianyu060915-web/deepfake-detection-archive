# Optional machine-specific settings; entering this directory never installs packages.
if [[ -f .envrc.local ]]; then source_env .envrc.local; fi

if [[ -n "${UV_PROJECT_ENVIRONMENT:-}" ]]; then
    if [[ -x "$UV_PROJECT_ENVIRONMENT/bin/python" ]]; then
        export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
        PATH_add "$VIRTUAL_ENV/bin"
    else
        echo "deepfake: missing $UV_PROJECT_ENVIRONMENT/bin/python" >&2
    fi
fi

export UV_NO_INSTALL_PROJECT=1
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
